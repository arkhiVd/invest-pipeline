# Safe default. Demo and test modes refuse real broker connections.
INVEST_MODE=demo
INVEST_DB=data/demo.duckdb
INVEST_UI_DB=data/ui/demo-ui.duckdb

# Optional local executable for narrative generation.
CODEX_BIN=codex

# Leave broker fields blank for demos and tests.
# Live read-only access also requires:
# INVEST_MODE=live
# INVEST_ALLOW_LIVE_BROKER_READS=READ_ONLY_ACKNOWLEDGED
KITE_API_KEY=
KITE_API_SECRET=
KITE_TOKEN_FILE=

# Optional notifications.
INVEST_BOT_TOKEN=
INVEST_CHAT_ID=

# Optional market-data provider.
BHARATSTOCK_API_KEY=
